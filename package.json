{
  "name": "modelsheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source data and tooling for the Modelsheet generative media model registry.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "npm run build:registry && npm run drift",
    "build:registry": "node scripts/build.mjs",
    "coverage": "node scripts/build.mjs",
    "drift": "node scripts/drift.mjs",
    "package:sync": "npm --prefix packages/registry run sync-data",
    "package:check-data": "npm --prefix packages/registry run check:data",
    "package:check": "npm --prefix packages/registry run check",
    "check:readme": "node scripts/check-readme-counts.mjs",
    "watch": "node scripts/watch.mjs",
    "test": "node --test",
    "test:drift": "node --test test/drift.test.mjs",
    "check": "npm run validate && npm test && npm run check:readme && npm run build && npm run package:check-data"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
